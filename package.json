{
  "name": "jungletribe",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:platform": "pnpm --filter @jungle-tribe/platform dev",
    "dev:mobile": "pnpm --filter @jungle-tribe/mobile dev",
    "dev:web": "pnpm --filter @jungle-tribe/mobile web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
